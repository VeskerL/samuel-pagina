---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import InicioBody from '../components/pages/InicioBody.astro';
import Base from '../layouts/Base.astro';
import { getInicio, getPosts } from '../lib/data';
import { islands } from '../lib/islands';

const page = await getInicio();
const posts = await getPosts();
const data = page.data.inicio;
---
<Base title={data.seo?.title} description={data.seo?.description}>
  <TinaIsland name="inicio" wrapper={islands.inicio.wrapper} primary>
    <InicioBody data={data} posts={posts} />
  </TinaIsland>
</Base>
