---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · Dr. Samuel Herrera">
  <main class="main">
    <section class="section section--top">
      <div class="wrap head head--center">
        <p class="eyebrow">Error 404</p>
        <h1 class="display display--md">Esta página no existe.</h1>
        <p class="lead lead--narrow">Puede que el enlace haya cambiado. Vuelve al inicio o cuéntanos tu caso.</p>
        <div class="actions actions--center">
          <a class="btn btn--dark" href="/">Ir al inicio</a>
          <a class="more" href="/evalua-tu-caso">Evalúa tu caso ›</a>
        </div>
      </div>
    </section>
  </main>
</Base>
