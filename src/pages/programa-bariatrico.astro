---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import BariatricoBody from '../components/pages/BariatricoBody.astro';
import Base from '../layouts/Base.astro';
import { getBariatrico } from '../lib/data';
import { islands } from '../lib/islands';

const page = await getBariatrico();
const data = page.data.bariatrico;
---
<Base title={data.seo?.title} description={data.seo?.description} theme="dark">
  <TinaIsland name="bariatrico" wrapper={islands.bariatrico.wrapper} primary>
    <BariatricoBody data={data} />
  </TinaIsland>
</Base>
