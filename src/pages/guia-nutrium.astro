---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import NutriumBody from '../components/pages/NutriumBody.astro';
import Base from '../layouts/Base.astro';
import { getNutrium } from '../lib/data';
import { islands } from '../lib/islands';

const page = await getNutrium();
const data = page.data.nutrium;
---
<Base title={data.seo?.title} description={data.seo?.description}>
  <TinaIsland name="nutrium" wrapper={islands.nutrium.wrapper} primary>
    <NutriumBody data={data} />
  </TinaIsland>
</Base>
