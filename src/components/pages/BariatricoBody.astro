---
import { tinaField } from '@tinacms/astro/tina-field';
import type { BariatricoQuery } from '../../../tina/__generated__/types';
import { has, href, lines, list } from '../../lib/utils';
import Hexagon from '../Hexagon.astro';

interface Props { data: BariatricoQuery['bariatrico'] }
const { data } = Astro.props;
const { hero, routesHead, phasesHead, faqHead, ctaBand } = data;
const routes = list(data.routes);
const phases = list(data.phases);
const faqs = list(data.faqs);
---
<section class="dark-hero">
  <Hexagon class="dark-hero__hex" stroke="#FFB700" strokeWidth={3} />
  <div class="wrap head head--center dark-hero__copy">
    <p class="eyebrow eyebrow--yellow" data-tina-field={tinaField(hero, 'eyebrow')}>{hero?.eyebrow}</p>
    <h1 class="display display--md display--light">
      <span data-tina-field={tinaField(hero, 'title')}>{hero?.title}</span><br />
      <span class="text-yellow" data-tina-field={tinaField(hero, 'highlight')}>{hero?.highlight}</span>
    </h1>
    <p class="lead lead--narrow lead--light" data-tina-field={tinaField(hero, 'subtitle')}>{hero?.subtitle}</p>
    <div class="actions actions--center">
      {hero?.primary?.label && <a class="btn btn--yellow" href={href(hero.primary.href)} data-tina-field={tinaField(hero, 'primary')}>{hero.primary.label}</a>}
      {hero?.secondary?.label && <a class="btn btn--line" href={href(hero.secondary.href)} data-tina-field={tinaField(hero, 'secondary')}>{hero.secondary.label}</a>}
    </div>
    <div class="stats" data-tina-field={tinaField(hero, 'stats')}>
      {list(hero?.stats).map((s) => (
        <div class="stats__item"><span class="stats__value">{s.value}</span><span class="stats__label">{s.label}</span></div>
      ))}
    </div>
  </div>
</section>

<section class="section section--gray" id="rutas">
  <div class="wrap stack-40 center-x" data-switch>
    <div class="head head--center">
      <p class="eyebrow" data-tina-field={tinaField(routesHead, 'eyebrow')}>{routesHead?.eyebrow}</p>
      <h2 class="h2" data-tina-field={tinaField(routesHead, 'title')}>{lines(routesHead?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
    </div>
    <div class="segmented" role="tablist" aria-label="Rutas bariátricas">
      {routes.map((r, i) => (
        <button type="button" class:list={['seg', i === 0 && 'is-active']} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-switch-to={i} data-tina-field={tinaField(r, 'tab')}>{r.tab}</button>
      ))}
    </div>
    {routes.map((r, i) => (
      <div class:list={['panel panel--white switch-panel', i === 0 && 'is-active']} role="tabpanel" data-switch-item={i}>
        <div class="stack-18">
          <p class="eyebrow eyebrow--muted" data-tina-field={tinaField(r, 'kicker')}>{r.kicker}</p>
          <h3 class="h2 h2--sm" data-tina-field={tinaField(r, 'title')}>{r.title}</h3>
          <p class="body body--lg" data-tina-field={tinaField(r, 'body')}>{r.body}</p>
          {has(r.ally) && (
            <div class="ally">
              <svg aria-hidden="true" width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="#002C45"></circle><circle cx="20" cy="16" r="6" fill="none" stroke="#FFB700" stroke-width="2"></circle><path d="M9 32c2-6 6-8 11-8s9 2 11 8" fill="none" stroke="#FFB700" stroke-width="2" stroke-linecap="round"></path></svg>
              <div><p class="small">En alianza con</p><p class="ally__name" data-tina-field={tinaField(r, 'ally')}>{r.ally}</p></div>
            </div>
          )}
        </div>
        <div class="facts">
          {list(r.facts).map((f) => (
            <div class="facts__row" data-tina-field={tinaField(f)}><span>{f.label}</span><strong>{f.value}</strong></div>
          ))}
          {r.cta?.label && <a class="btn btn--dark btn--start" href={href(r.cta.href)} data-tina-field={tinaField(r, 'cta')}>{r.cta.label}</a>}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="section">
  <div class="wrap stack-48">
    <div class="head">
      <p class="eyebrow" data-tina-field={tinaField(phasesHead, 'eyebrow')}>{phasesHead?.eyebrow}</p>
      <h2 class="h2" data-tina-field={tinaField(phasesHead, 'title')}>{lines(phasesHead?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
    </div>
    <div class="grid grid--320">
      {phases.map((p) => (
        <div class="tile tone-gray">
          <span class="tag tag--navy" data-tina-field={tinaField(p, 'tag')}>{p.tag}</span>
          <h3 class="h3" data-tina-field={tinaField(p, 'title')}>{p.title}</h3>
          <p class="body" data-tina-field={tinaField(p, 'body')}>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section--flush">
  <div class="wrap split split--top">
    <div class="stack-18">
      <p class="eyebrow" data-tina-field={tinaField(faqHead, 'eyebrow')}>{faqHead?.eyebrow}</p>
      <h2 class="h2" data-tina-field={tinaField(faqHead, 'title')}>{lines(faqHead?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
      <p class="lead" data-tina-field={tinaField(faqHead, 'subtitle')}>{faqHead?.subtitle}</p>
      {faqHead?.cta?.label && <a class="btn btn--dark btn--start" href={href(faqHead.cta.href)} data-tina-field={tinaField(faqHead, 'cta')}>{faqHead.cta.label}</a>}
    </div>
    <div class="faq">
      {faqs.map((f, i) => (
        <details class="faq__item" open={i === 0}>
          <summary data-tina-field={tinaField(f, 'question')}>{f.question}<span class="faq__sign" aria-hidden="true"></span></summary>
          <p class="body" data-tina-field={tinaField(f, 'answer')}>{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="band band--navy">
      <h2 class="h2 h2--light" data-tina-field={tinaField(ctaBand, 'title')}>{lines(ctaBand?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
      <p class="lead lead--narrow lead--light" data-tina-field={tinaField(ctaBand, 'subtitle')}>{ctaBand?.subtitle}</p>
      {ctaBand?.button?.label && <a class="btn btn--yellow" href={href(ctaBand.button.href)} data-tina-field={tinaField(ctaBand, 'button')}>{ctaBand.button.label}</a>}
    </div>
  </div>
</section>
