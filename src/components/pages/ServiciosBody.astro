---
import { tinaField } from '@tinacms/astro/tina-field';
import type { ServiciosQuery } from '../../../tina/__generated__/types';
import { has, href, lines, list } from '../../lib/utils';
import Check from '../Check.astro';

interface Props { data: ServiciosQuery['servicios'] }
const { data } = Astro.props;
const { hero, plansHead, extrasHead, business } = data;
const consultas = list(data.consultas);
const plans = list(data.plans);
const extras = list(data.extras);
---
<section class="section section--top">
  <div class="wrap head head--center">
    <p class="eyebrow" data-tina-field={tinaField(hero, 'eyebrow')}>{hero?.eyebrow}</p>
    <h1 class="display display--md" data-tina-field={tinaField(hero, 'title')}>{lines(hero?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
    <p class="lead lead--narrow" data-tina-field={tinaField(hero, 'subtitle')}>{hero?.subtitle}</p>
  </div>
</section>

<section class="section section--flush">
  <div class="wrap grid grid--420">
    {consultas.map((c) => (
      <div class:list={['tile tile--lg', c.featured ? 'tone-navy' : 'tone-gray']}>
        <p class:list={['eyebrow', c.featured && 'eyebrow--yellow']} data-tina-field={tinaField(c, 'kicker')}>{c.kicker}</p>
        <p class="price" data-tina-field={tinaField(c, 'price')}>{c.price}</p>
        <p class="body" data-tina-field={tinaField(c, 'body')}>{c.body}</p>
        {c.cta?.label && <a class:list={['btn btn--start', c.featured ? 'btn--yellow' : 'btn--ghost']} href={href(c.cta.href)} data-tina-field={tinaField(c, 'cta')}>{c.cta.label}</a>}
      </div>
    ))}
  </div>
</section>

<section class="section section--gray" id="planes">
  <div class="wrap stack-48" data-switch>
    <div class="head head--center">
      <p class="eyebrow" data-tina-field={tinaField(plansHead, 'eyebrow')}>{plansHead?.eyebrow}</p>
      <h2 class="h2" data-tina-field={tinaField(plansHead, 'title')}>{lines(plansHead?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
      <p class="lead lead--narrow" data-tina-field={tinaField(plansHead, 'subtitle')}>{plansHead?.subtitle}</p>
      <div class="pills pills--center" role="group" aria-label="¿Cuál es para mí?">
        {plans.map((p, i) => has(p.chooser) && (
          <button type="button" class:list={['pill', i === 0 && 'is-active']} aria-pressed={i === 0 ? 'true' : 'false'} data-switch-to={i} data-tina-field={tinaField(p, 'chooser')}>{p.chooser}</button>
        ))}
      </div>
    </div>
    <div class="grid grid--320 grid--stretch">
      {plans.map((p, i) => (
        <div class:list={['plan', i === 0 && 'is-active']} data-switch-item={i}>
          <div class="plan__top">
            <h3 class="h3" data-tina-field={tinaField(p, 'name')}>{p.name}</h3>
            {has(p.discount) && <span class="tag tag--yellow" data-tina-field={tinaField(p, 'discount')}>{p.discount}</span>}
          </div>
          <p class="body plan__desc" data-tina-field={tinaField(p, 'description')}>{p.description}</p>
          <div>
            <p class="price price--md" data-tina-field={tinaField(p, 'price')}>{p.price}</p>
            <p class="small" data-tina-field={tinaField(p, 'savings')}>{p.savings}</p>
          </div>
          <hr class="rule" />
          <div class="checklist checklist--plain" data-tina-field={tinaField(p, 'items')}>
            {list(p.items).map((it) => <div class="checklist__item"><Check size={22} /><span>{it}</span></div>)}
          </div>
          {p.cta?.label && <a class="btn btn--dark plan__cta" href={href(p.cta.href)} data-tina-field={tinaField(p, 'cta')}>{p.cta.label}</a>}
        </div>
      ))}
    </div>
    <p class="fineprint" data-tina-field={tinaField(data, 'plansLegal')}>{data.plansLegal}</p>
  </div>
</section>

<section class="section">
  <div class="wrap stack-40">
    <div class="head">
      <p class="eyebrow" data-tina-field={tinaField(extrasHead, 'eyebrow')}>{extrasHead?.eyebrow}</p>
      <h2 class="h2" data-tina-field={tinaField(extrasHead, 'title')}>{lines(extrasHead?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
    </div>
    <div class="grid grid--340">
      {extras.map((x) => (
        <div class:list={['tile', `tone-${x.tone || 'gray'}`]}>
          <p class:list={['eyebrow', x.tone === 'navy' && 'eyebrow--yellow']} data-tina-field={tinaField(x, 'kicker')}>{x.kicker}</p>
          <h3 class="h3" data-tina-field={tinaField(x, 'title')}>{x.title}</h3>
          <p class="body" data-tina-field={tinaField(x, 'body')}>{x.body}</p>
          {x.cta?.label && <a class="more tile__link" href={href(x.cta.href)} data-tina-field={tinaField(x, 'cta')}>{x.cta.label}</a>}
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section--flush">
  <div class="wrap">
    <div class="box split split--40">
      <div class="stack-18">
        <p class="eyebrow" data-tina-field={tinaField(business, 'eyebrow')}>{business?.eyebrow}</p>
        <h2 class="h2 h2--md" data-tina-field={tinaField(business, 'title')}>{lines(business?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
        {business?.cta?.label && <a class="btn btn--dark btn--start" href={href(business.cta.href)} data-tina-field={tinaField(business, 'cta')}>{business.cta.label}</a>}
      </div>
      <div class="grid grid--220 grid--tight">
        {list(business?.items).map((it) => (
          <div class="mini">
            <p class="mini__title" data-tina-field={tinaField(it, 'title')}>{it.title}</p>
            <p class="body body--sm" data-tina-field={tinaField(it, 'body')}>{it.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
