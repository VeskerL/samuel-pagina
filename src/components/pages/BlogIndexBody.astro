---
import { tinaField } from '@tinacms/astro/tina-field';
import type { BlogQuery } from '../../../tina/__generated__/types';
import type { PostSummary } from '../../lib/data';
import { CATEGORY_LABELS, has, img, lines } from '../../lib/utils';
import AudioPlayer from '../AudioPlayer.astro';
import PostCard from '../PostCard.astro';

interface Props { data: BlogQuery['blog']; posts: PostSummary[] }
const { data, posts } = Astro.props;
const { hero, ask } = data;
const featured = posts.find((p) => p.featured) ?? posts[0];
const usedCats = Object.keys(CATEGORY_LABELS).filter((c) => posts.some((p) => p.category === c));
const featuredImg = featured ? img(featured.image) : '';
---
<section class="section section--top">
  <div class="wrap"><div class="head">
    <p class="eyebrow" data-tina-field={tinaField(hero, 'eyebrow')}>{hero?.eyebrow}</p>
    <h1 class="display display--md" data-tina-field={tinaField(hero, 'title')}>{lines(hero?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
    <p class="lead lead--narrow" data-tina-field={tinaField(hero, 'subtitle')}>{hero?.subtitle}</p>
  </div></div>
</section>

{featured && (
  <section class="section section--flush">
    <div class="wrap">
      <div class="feature">
        <div class="feature__copy">
          <p class="eyebrow eyebrow--yellow"><span data-tina-field={tinaField(data, 'featuredLabel')}>{data.featuredLabel}</span> · {CATEGORY_LABELS[featured.category ?? ''] ?? 'Blog'}</p>
          <h2 class="h2 h2--light">{featured.title}</h2>
          <p class="lead lead--light">{featured.excerpt}</p>
          <AudioPlayer src={img(featured.audio)} duration={featured.duration} dark />
          <a class="more more--yellow" href={`/blog/${featured._sys.filename}`} data-tina-field={tinaField(data, 'readMoreLabel')}>{data.readMoreLabel}</a>
        </div>
        <img class="feature__img" src={featuredImg || '/uploads/doctor-retrato.jpg'} alt="Retrato del Dr. Samuel Herrera" loading="lazy" />
      </div>
    </div>
  </section>
)}

<section class="section section--flush" data-filter-group>
  <div class="wrap stack-36">
    <div class="pills" role="group" aria-label="Categorías">
      <button type="button" class="pill is-active" aria-pressed="true" data-filter="">Todos</button>
      {usedCats.map((c) => <button type="button" class="pill" aria-pressed="false" data-filter={c}>{CATEGORY_LABELS[c]}</button>)}
    </div>
    <div class="grid grid--300 grid--posts">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </div>
</section>

<section class="section section--flush">
  <div class="wrap">
    <div class="box box--cream split split--40">
      <div class="stack-16">
        <p class="eyebrow" data-tina-field={tinaField(ask, 'eyebrow')}>{ask?.eyebrow}</p>
        <h2 class="h2 h2--md" data-tina-field={tinaField(ask, 'title')}>{lines(ask?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
        <p class="body" data-tina-field={tinaField(ask, 'subtitle')}>{ask?.subtitle}</p>
      </div>
      <form class="stack-14" data-ask-form data-webhook={ask?.webhookUrl ?? ''} data-thanks={ask?.thanks ?? ''}>
        <label for="pregunta" class="label" data-tina-field={tinaField(ask, 'fieldLabel')}>{ask?.fieldLabel}</label>
        <textarea id="pregunta" name="pregunta" class="field" rows="4" required placeholder={ask?.placeholder ?? ''} data-tina-field={tinaField(ask, 'placeholder')}></textarea>
        <button type="submit" class="btn btn--dark btn--start" data-tina-field={tinaField(ask, 'button')}>{ask?.button}</button>
        <p class="small" role="status" aria-live="polite" data-ask-status></p>
      </form>
    </div>
  </div>
</section>
