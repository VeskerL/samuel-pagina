---
import { tinaField } from '@tinacms/astro/tina-field';
import type { NutriumQuery } from '../../../tina/__generated__/types';
import { href, isExternal, lines, list } from '../../lib/utils';

interface Props { data: NutriumQuery['nutrium'] }
const { data } = Astro.props;
const { hero, ctaBand } = data;
const steps = list(data.steps);
const faqs = list(data.faqs);
const total = steps.length;
const download = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14" fill="none" stroke="#FFB700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
---
<section class="section section--top section--cream">
  <div class="wrap head head--center">
    <p class="eyebrow" data-tina-field={tinaField(hero, 'eyebrow')}>{hero?.eyebrow}</p>
    <h1 class="display display--md" data-tina-field={tinaField(hero, 'title')}>{lines(hero?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
    <p class="lead lead--narrow" data-tina-field={tinaField(hero, 'subtitle')}>{hero?.subtitle}</p>
    <div class="actions actions--center">
      <a class="store" href={href(hero?.appStoreUrl)} target={isExternal(href(hero?.appStoreUrl)) ? '_blank' : undefined} rel="noopener" data-tina-field={tinaField(hero, 'appStoreUrl')}><Fragment set:html={download} />Descargar en App Store</a>
      <a class="store" href={href(hero?.googlePlayUrl)} target={isExternal(href(hero?.googlePlayUrl)) ? '_blank' : undefined} rel="noopener" data-tina-field={tinaField(hero, 'googlePlayUrl')}><Fragment set:html={download} />Descargar en Google Play</a>
    </div>
  </div>
</section>

<section class="section section--gray">
  <div class="wrap split" data-switch>
    <div class="steps">
      {steps.map((s, i) => (
        <button type="button" class:list={['step', i === 0 && 'is-active']} aria-pressed={i === 0 ? 'true' : 'false'} data-switch-to={i} data-switch-item={i}>
          <span class="step__num">{i + 1}</span>
          <span class="step__copy">
            <span class="step__title" data-tina-field={tinaField(s, 'title')}>{s.title}</span>
            <span class="step__text" data-tina-field={tinaField(s, 'text')}>{s.text}</span>
          </span>
        </button>
      ))}
      <div class="steps__nav">
        <button type="button" class="btn btn--ghost btn--sm" data-switch-step="-1">Anterior</button>
        <button type="button" class="btn btn--dark btn--sm" data-switch-step="1">Siguiente paso</button>
      </div>
    </div>
    <div class="phone-wrap">
      <div class="phone phone--lg">
        {steps.map((s, i) => (
          <div class:list={['phone__screen switch-panel', i === 0 && 'is-active']} data-switch-item={i} aria-live="polite">
            <p class="phone__step">PASO {i + 1} DE {total}</p>
            <p class="phone__title phone__title--lg" data-tina-field={tinaField(s, 'screen')}>{s.screen}</p>
            {list(s.rows).map((r) => <div class="phone__row"><span class="dot"></span><span>{r}</span></div>)}
            <div class="phone__btn" data-tina-field={tinaField(s, 'action')}>{s.action}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap grid grid--320">
    {faqs.map((f) => (
      <div class="tile tone-gray">
        <p class="mini__title mini__title--lg" data-tina-field={tinaField(f, 'question')}>{f.question}</p>
        <p class="body" data-tina-field={tinaField(f, 'answer')}>{f.answer}</p>
      </div>
    ))}
  </div>
</section>

<section class="section section--flush">
  <div class="wrap">
    <div class="band band--navy">
      <h2 class="h2 h2--light" data-tina-field={tinaField(ctaBand, 'title')}>{lines(ctaBand?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
      <div class="actions actions--center">
        {ctaBand?.primary?.label && <a class="btn btn--yellow" href={href(ctaBand.primary.href)} data-tina-field={tinaField(ctaBand, 'primary')}>{ctaBand.primary.label}</a>}
        {ctaBand?.secondary?.label && <a class="btn btn--line" href={href(ctaBand.secondary.href)} data-tina-field={tinaField(ctaBand, 'secondary')}>{ctaBand.secondary.label}</a>}
      </div>
    </div>
  </div>
</section>
