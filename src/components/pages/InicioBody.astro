---
import { tinaField } from '@tinacms/astro/tina-field';
import type { InicioQuery } from '../../../tina/__generated__/types';
import type { PostSummary } from '../../lib/data';
import { has, href, img, lines, list } from '../../lib/utils';
import Check from '../Check.astro';
import Hexagon from '../Hexagon.astro';
import PostCard from '../PostCard.astro';

interface Props { data: InicioQuery['inicio']; posts: PostSummary[] }
const { data, posts } = Astro.props;
const { hero, areasHead, stepsHead, quote, nutrium, blog, ctaBand } = data;
const areas = list(data.areas);
const steps = list(data.steps);
---
<section class="hero">
  <div class="wrap hero__copy">
    <p class="eyebrow" data-tina-field={tinaField(hero, 'eyebrow')}>{hero?.eyebrow}</p>
    <h1 class="display" data-tina-field={tinaField(hero, 'title')}>{lines(hero?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
    <p class="lead lead--narrow" data-tina-field={tinaField(hero, 'subtitle')}>{hero?.subtitle}</p>
    <div class="actions actions--center">
      {hero?.primary?.label && <a class="btn btn--dark" href={href(hero.primary.href)} data-tina-field={tinaField(hero, 'primary')}>{hero.primary.label}</a>}
      {hero?.secondary?.label && <a class="more" href={href(hero.secondary.href)} data-tina-field={tinaField(hero, 'secondary')}>{hero.secondary.label}</a>}
    </div>
  </div>
  <div class="wrap">
    <div class="stage">
      <Hexagon class="stage__hex" />
      <Hexagon class="stage__hex-line" stroke="#ffffff" strokeWidth={6} />
      <Hexagon class="stage__hex-dot" />
      {img(hero?.image) && (
        <img class="stage__photo" src={img(hero?.image)} alt={hero?.imageAlt ?? ''} data-tina-field={tinaField(hero, 'image')} width="506" height="675" fetchpriority="high" />
      )}
      <div class="stage__chips stage__chips--left" data-tina-field={tinaField(hero, 'chipsLeft')}>
        {list(hero?.chipsLeft).map((c) => <span class="chip"><span class="dot"></span>{c}</span>)}
      </div>
      <div class="stage__chips stage__chips--right" data-tina-field={tinaField(hero, 'chipsRight')}>
        {list(hero?.chipsRight).map((c) => <span class="chip"><span class="dot"></span>{c}</span>)}
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap stack-48">
    <div class="head">
      <p class="eyebrow" data-tina-field={tinaField(areasHead, 'eyebrow')}>{areasHead?.eyebrow}</p>
      <h2 class="h2" data-tina-field={tinaField(areasHead, 'title')}>{lines(areasHead?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
      {has(areasHead?.subtitle) && <p class="lead" data-tina-field={tinaField(areasHead, 'subtitle')}>{areasHead?.subtitle}</p>}
    </div>
    <div data-switch>
      <div class="pills" role="tablist" aria-label="Áreas de consulta">
        {areas.map((a, i) => (
          <button type="button" class:list={['pill', i === 0 && 'is-active']} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-switch-to={i} data-tina-field={tinaField(a, 'label')}>{a.label}</button>
        ))}
      </div>
      {areas.map((a, i) => (
        <div class:list={['panel switch-panel', i === 0 && 'is-active']} role="tabpanel" data-switch-item={i}>
          <div class="stack-18">
            <p class="eyebrow eyebrow--muted" data-tina-field={tinaField(a, 'kicker')}>{a.kicker}</p>
            <h3 class="h2 h2--md" data-tina-field={tinaField(a, 'title')}>{a.title}</h3>
            <p class="body body--lg" data-tina-field={tinaField(a, 'body')}>{a.body}</p>
            <div class="actions">
              {a.cta?.label && <a class="btn btn--dark" href={href(a.cta.href)} data-tina-field={tinaField(a, 'cta')}>{a.cta.label}</a>}
              <a class="more" href="/evalua-tu-caso">Evalúa tu caso ›</a>
            </div>
          </div>
          <div class="checklist" data-tina-field={tinaField(a, 'points')}>
            {list(a.points).map((p) => <div class="checklist__item"><Check /><span>{p}</span></div>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section--gray">
  <div class="wrap stack-56">
    <div class="head head--center">
      <p class="eyebrow" data-tina-field={tinaField(stepsHead, 'eyebrow')}>{stepsHead?.eyebrow}</p>
      <h2 class="h2" data-tina-field={tinaField(stepsHead, 'title')}>{lines(stepsHead?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
      <p class="lead lead--narrow" data-tina-field={tinaField(stepsHead, 'subtitle')}>{stepsHead?.subtitle}</p>
    </div>
    <div class="grid grid--250">
      {steps.map((s, i) => (
        <div class="card">
          <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h3" data-tina-field={tinaField(s, 'title')}>{s.title}</h3>
          <p class="body" data-tina-field={tinaField(s, 'body')}>{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="quote">
      {img(quote?.image) && <img class="quote__img" src={img(quote?.image)} alt={quote?.imageAlt ?? ''} loading="lazy" data-tina-field={tinaField(quote, 'image')} />}
      <div class="quote__copy">
        <p class="eyebrow eyebrow--yellow" data-tina-field={tinaField(quote, 'eyebrow')}>{quote?.eyebrow}</p>
        <p class="quote__text" data-tina-field={tinaField(quote, 'text')}>{quote?.text}</p>
        <p class="quote__author" data-tina-field={tinaField(quote, 'author')}>{quote?.author}</p>
      </div>
    </div>
  </div>
</section>

<section class="section section--cream">
  <div class="wrap split">
    <div class="stack-20">
      <p class="eyebrow" data-tina-field={tinaField(nutrium, 'eyebrow')}>{nutrium?.eyebrow}</p>
      <h2 class="h2" data-tina-field={tinaField(nutrium, 'title')}>{lines(nutrium?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
      <p class="lead" data-tina-field={tinaField(nutrium, 'subtitle')}>{nutrium?.subtitle}</p>
      <div class="actions">
        {nutrium?.primary?.label && <a class="btn btn--dark" href={href(nutrium.primary.href)} data-tina-field={tinaField(nutrium, 'primary')}>{nutrium.primary.label}</a>}
        {nutrium?.secondary?.label && <a class="more" href={href(nutrium.secondary.href)} data-tina-field={tinaField(nutrium, 'secondary')}>{nutrium.secondary.label}</a>}
      </div>
    </div>
    <div class="phone-wrap">
      <div class="phone" aria-hidden="true">
        <div class="phone__screen">
          <p class="phone__small">Hoy</p>
          <p class="phone__title">Tu plan del día</p>
          <div class="phone__row phone__row--stack"><span class="phone__tag">DESAYUNO</span><span>[Comida del plan]</span></div>
          <div class="phone__row phone__row--stack"><span class="phone__tag">ALMUERZO</span><span>[Comida del plan]</span></div>
          <div class="phone__row phone__row--stack phone__row--dark"><span class="phone__tag phone__tag--yellow">MENSAJE DEL DOCTOR</span><span>Vamos bien. Esta semana subimos la fibra poco a poco.</span></div>
          <div class="phone__btn phone__btn--yellow">Agendar control</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap stack-48">
    <div class="head-row">
      <div class="head">
        <p class="eyebrow" data-tina-field={tinaField(blog, 'eyebrow')}>{blog?.eyebrow}</p>
        <h2 class="h2" data-tina-field={tinaField(blog, 'title')}>{lines(blog?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
        <p class="lead lead--narrow" data-tina-field={tinaField(blog, 'subtitle')}>{blog?.subtitle}</p>
      </div>
      <a class="more" href="/blog" data-tina-field={tinaField(blog, 'linkLabel')}>{blog?.linkLabel}</a>
    </div>
    <div class="grid grid--300">
      {posts.slice(0, 3).map((p) => <PostCard post={p} />)}
    </div>
  </div>
</section>

<section class="section section--flush">
  <div class="wrap">
    <div class="band band--yellow">
      <h2 class="h2" data-tina-field={tinaField(ctaBand, 'title')}>{lines(ctaBand?.title).map((l, i) => <>{i > 0 && <br />}{l}</>)}</h2>
      <p class="lead lead--narrow" data-tina-field={tinaField(ctaBand, 'subtitle')}>{ctaBand?.subtitle}</p>
      {ctaBand?.button?.label && <a class="btn btn--dark" href={href(ctaBand.button.href)} data-tina-field={tinaField(ctaBand, 'button')}>{ctaBand.button.label}</a>}
    </div>
  </div>
</section>
