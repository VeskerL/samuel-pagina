---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import Head from './Head.astro';

interface Props { block: any; first?: boolean }
const { block, first } = Astro.props;
---
<section class="section" data-tina-field={tinaField(block)}>
  <div class="wrap wrap--narrow stack-22">
    <Head block={block} first={first} />
    {block.body && (
      <div class="prose" data-tina-field={tinaField(block, 'body')}>
        <TinaMarkdown content={block.body} />
      </div>
    )}
  </div>
</section>
