---
import { tinaField } from '@tinacms/astro/tina-field';
import { list } from '../../lib/utils';
import Head from './Head.astro';

interface Props { block: any; first?: boolean }
const { block, first } = Astro.props;
const steps = list<any>(block.steps);
---
<section class:list={['section', `tone-section-${block.tone || 'gray'}`]} data-tina-field={tinaField(block)}>
  <div class="wrap stack-48">
    <Head block={block} first={first} center />
    <div class="split" data-switch>
      <div class="steps">
        {steps.map((s, i) => (
          <button type="button" class:list={['step', i === 0 && 'is-active']} aria-pressed={i === 0 ? 'true' : 'false'} data-switch-to={i} data-switch-item={i} data-tina-field={tinaField(block, 'steps', i)}>
            <span class="step__num">{i + 1}</span>
            <span class="step__copy">
              <span class="step__title" data-tina-field={tinaField(s, 'title')}>{s.title}</span>
              <span class="step__text" data-tina-field={tinaField(s, 'text')}>{s.text}</span>
            </span>
          </button>
        ))}
        <div class="steps__nav">
          <button type="button" class="btn btn--ghost btn--sm" data-switch-step="-1">Anterior</button>
          <button type="button" class="btn btn--dark btn--sm" data-switch-step="1">Siguiente paso</button>
        </div>
      </div>
      <div class="phone-wrap">
        <div class="phone phone--lg">
          {steps.map((s, i) => (
            <div class:list={['phone__screen switch-panel', i === 0 && 'is-active']} data-switch-item={i}>
              <p class="phone__step">PASO {i + 1} DE {steps.length}</p>
              <p class="phone__title phone__title--lg" data-tina-field={tinaField(s, 'screen')}>{s.screen}</p>
              {list<string>(s.rows).map((r) => <div class="phone__row"><span class="dot"></span><span>{r}</span></div>)}
              <div class="phone__btn" data-tina-field={tinaField(s, 'action')}>{s.action}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
