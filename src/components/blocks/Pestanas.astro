---
import { tinaField } from '@tinacms/astro/tina-field';
import { has, href, list } from '../../lib/utils';
import Check from '../Check.astro';
import Head from './Head.astro';

interface Props { block: any; first?: boolean }
const { block, first } = Astro.props;
const items = list<any>(block.items);
const center = block.align === 'center';
const segmented = block.variant === 'segmented';
const panelBg = block.tone === 'gray' ? 'panel--white' : '';
---
<section class:list={['section', `tone-section-${block.tone || 'white'}`]} id={has(block.anchor) ? block.anchor : undefined} data-tina-field={tinaField(block)}>
  <div class:list={['wrap stack-40', center && 'center-x']} data-switch>
    <Head block={block} first={first} center={center} />
    <div class:list={[segmented ? 'segmented' : 'pills', center && !segmented && 'pills--center']} role="tablist" data-tina-field={tinaField(block, 'items')}>
      {items.map((it, i) => (
        <button type="button" class:list={[segmented ? 'seg' : 'pill', i === 0 && 'is-active']} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-switch-to={i}>{it.label}</button>
      ))}
    </div>
    {items.map((it, i) => (
      <div class:list={['panel switch-panel', panelBg, i === 0 && 'is-active']} role="tabpanel" data-switch-item={i} data-tina-field={tinaField(block, 'items', i)}>
        <div class="stack-18">
          {has(it.kicker) && <p class="eyebrow eyebrow--muted" data-tina-field={tinaField(it, 'kicker')}>{it.kicker}</p>}
          <h3 class="h2 h2--sm" data-tina-field={tinaField(it, 'title')}>{it.title}</h3>
          {has(it.body) && <p class="body body--lg" data-tina-field={tinaField(it, 'body')}>{it.body}</p>}
          {has(it.ally) && (
            <div class="ally">
              <svg aria-hidden="true" width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="#002C45"></circle><circle cx="20" cy="16" r="6" fill="none" stroke="#FFB700" stroke-width="2"></circle><path d="M9 32c2-6 6-8 11-8s9 2 11 8" fill="none" stroke="#FFB700" stroke-width="2" stroke-linecap="round"></path></svg>
              <div><p class="small">En alianza con</p><p class="ally__name" data-tina-field={tinaField(it, 'ally')}>{it.ally}</p></div>
            </div>
          )}
          {list<any>(it.facts).length === 0 && (it.cta?.label || it.link?.label) && (
            <div class="actions">
              {it.cta?.label && <a class="btn btn--dark" href={href(it.cta.href)} data-tina-field={tinaField(it, 'cta')}>{it.cta.label}</a>}
              {it.link?.label && <a class="more" href={href(it.link.href)} data-tina-field={tinaField(it, 'link')}>{it.link.label}</a>}
            </div>
          )}
        </div>
        {list<any>(it.facts).length > 0 ? (
          <div class="facts">
            {list<any>(it.facts).map((f) => <div class="facts__row" data-tina-field={tinaField(f)}><span>{f.label}</span><strong>{f.value}</strong></div>)}
            {it.cta?.label && <a class="btn btn--dark btn--start" href={href(it.cta.href)} data-tina-field={tinaField(it, 'cta')}>{it.cta.label}</a>}
          </div>
        ) : (
          <div class="checklist" data-tina-field={tinaField(it, 'points')}>
            {list<string>(it.points).map((p) => <div class="checklist__item"><Check /><span>{p}</span></div>)}
          </div>
        )}
      </div>
    ))}
  </div>
</section>
