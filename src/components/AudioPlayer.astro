---
interface Props { src?: string | null; duration?: string | null; dark?: boolean; field?: string }
const { src, duration, dark = false, field } = Astro.props;
---
<div class:list={['player', dark && 'player--dark']} data-audio data-tina-field={field}>
  {src && <audio preload="none" src={src}></audio>}
  <button type="button" class="player__btn" aria-label={src ? 'Reproducir episodio' : 'Audio aún no disponible'} disabled={!src}>
    <svg class="player__play" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    <svg class="player__pause" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"></rect><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"></rect></svg>
  </button>
  <div class="player__body">
    <div class="player__bar"><div class="player__fill"></div></div>
    <div class="player__meta">
      <span class="player__status">{src ? 'Escuchar episodio' : 'Audio próximamente'}</span>
      <span class="player__time">{duration}</span>
    </div>
  </div>
</div>
